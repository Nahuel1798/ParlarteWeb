  "methodology": {
    "kicker": "Nuestra Metodología",
    "title": "Un Método que se Siente Natural",
    "subtitle": "No aprendemos italiano de memoria: lo vivimos. Combinamos rigor académico con la autenticidad de la vida italiana.",
    "step1Title": "Inmersión Lingüística",
    "step1Description": "Aprende en situaciones reales y cotidianas. Desde el primer día hablamos italiano para que tu oído y tu voz se acostumbren al idioma de forma natural.",
    "step2Title": "Método Comunicativo",
    "step2Description": "La conversación es el corazón de nuestras clases. Expresamos ideas, debatimos y resolvemos situaciones auténticas, no solo memorizamos reglas.",
    "step3Title": "Marco CEFR / MCER",
    "step3Description": "Progresión estructurada y medible alineada con el Marco Común Europeo de Referencia (A1 → C2) para certificarte de forma oficial.",
    "step4Title": "Cultura Italiana",
    "step4Description": "La dolce vita es parte del programa: literatura, cine, cocina y tradiciones que convierten cada clase en un viaje por Italia."
  },
